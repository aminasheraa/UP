<Window x:Class="UP.Windows.RoleApplicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP.Windows"
        mc:Ignorable="d"
        Title="Заявка на роль автора" Height="320" Width="800">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Стать автором" FontSize="20" FontWeight="Bold" FontFamily="Book Antiqua" Margin="0,0,0,10"/>
            <TextBlock Text="Расскажите немного о себе и о книгах, которые вы планируете публиковать:" TextWrapping="Wrap" Margin="0,0,0,10" FontFamily="Book Antiqua"/>
            <TextBox x:Name="DescriptionTB" Height="120" TextWrapping="Wrap" FontFamily="Book Antiqua" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15" Padding="5"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="90" Height="30" Margin="5" FontFamily="Book Antiqua" Click="CancelBtn_Click"/>
                <Button Content="Отправить заявку" Width="130" Height="30" FontFamily="Book Antiqua" Margin="5" Click="SendBtn_Click" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
