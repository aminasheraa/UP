<Window x:Class="UP.Windows.UnfreezeApplicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP.Windows"
        mc:Ignorable="d"
        Title="UnfreezeApplicationWindow" Height="300" Width="800">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Оспорить заморозку" FontSize="18" FontWeight="Bold" FontFamily="Book Antiqua" Margin="0,0,0,10"/>
            <TextBlock Text="Опишите причину, по которой мы должны разморозить ваш аккаунт:" FontFamily="Book Antiqua" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBox x:Name="DescriptionTB" Height="100" TextWrapping="Wrap" FontFamily="Book Antiqua" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="80" Margin="5" Click="CancelBtn_Click" FontFamily="Book Antiqua"/>
                <Button Content="Отправить" Width="100" Margin="5" Click="SendBtn_Click" FontFamily="Book Antiqua" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
