<Window x:Class="UP.Windows.ComplaintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP.Windows"
        mc:Ignorable="d"
        Title="ComplaintWindow" Height="320" Width="800">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Оформление жалобы" FontSize="18" FontFamily="Book Antiqua" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Опишите причину жалобы:" FontFamily="Book Antiqua" Margin="0,0,0,5"/>
            <TextBox x:Name="DescriptionTB" Height="150" TextWrapping="Wrap"  AcceptsReturn="True" FontFamily="Book Antiqua"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Отменить" Width="100" Height="30" Click="BtnCancel_Click" FontFamily="Book Antiqua" Margin="0,0,10,0"/>
                <Button Content="Отправить" Width="100" Height="30" Click="BtnSend_Click" FontFamily="Book Antiqua"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
