<Page x:Class="UP.Pages.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AccountPage" Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть -->
        <StackPanel Margin="10">
            <TextBlock Text="Профиль"
                       FontSize="24"
                       FontWeight="Bold"
                       FontFamily="Book Antiqua"
                       Margin="10"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Логин:" Margin="5"/>
                <TextBlock Text="{Binding Login}" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Имя:" Margin="5"/>
                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Email:" Margin="5"/>
                <TextBlock Text="{Binding Email}" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Роль:" Margin="5"/>
                <TextBlock Text="{Binding Role.Name}" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <!-- Правая часть -->
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Отзывы пользователя"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="10"/>

            <ListBox x:Name="ReviewListBox">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Book.Name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Text}"/>
                            <TextBlock Text="{Binding Rating, StringFormat=Оценка: {0}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

    </Grid>
</Page>
