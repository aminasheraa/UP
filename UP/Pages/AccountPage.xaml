<Page x:Class="UP.Pages.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AccountPage" Background="White">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Профиль" FontSize="26" FontWeight="Bold" FontFamily="Book Antiqua" Margin="0,0,0,20"/>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Логин: " FontFamily="Book Antiqua"/>
                        <TextBlock Text="{Binding Login}" FontWeight="Bold" FontFamily="Book Antiqua"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Имя: " FontFamily="Book Antiqua" />
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontFamily="Book Antiqua"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Email: " FontFamily="Book Antiqua"/>
                        <TextBlock Text="{Binding Email}" FontWeight="Bold" FontFamily="Book Antiqua"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Роль: " FontFamily="Book Antiqua" />
                        <TextBlock Text="{Binding Role.Name}" FontWeight="Bold" FontFamily="Book Antiqua"/>
                    </StackPanel>
                    
                    
                </StackPanel>

            <Button x:Name="AuthorRequestBtn" Content="Стать автором" Margin="0,20,0,0" Height="35" FontFamily="Book Antiqua" Click="AuthorRequestBtn_Click" Visibility="Collapsed"/>

            <Border x:Name="FrozenPanel" Visibility="Collapsed" Background="White" BorderBrush="#A9A9A9" BorderThickness="1" CornerRadius="5" Margin="0,20,0,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="⚠ Аккаунт заморожен" FontWeight="Bold" Margin="0,0,0,5" FontFamily="Book Antiqua"/>
                    <TextBlock x:Name="FreezeReasonTxt" Text="Причина не указана" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10" FontFamily="Book Antiqua"/>
                    <Button Content="Оспорить заморозку" Click="AppealBtn_Click" FontSize="11" Height="25" FontFamily="Book Antiqua"/>
                </StackPanel>
            </Border>
            <Button x:Name="ExitBtn" Content="Выйти из аккаунта" Margin="0, 10, 0,0" Height="35" FontFamily="Book Antiqua" Click="ExitBtn_Click"/>

        </StackPanel>

        <Grid Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Мои отзывы" FontSize="20" FontWeight="Bold" FontFamily="Book Antiqua" Margin="0,0,0,15"/>

            <ListBox x:Name="ReviewListBox" Grid.Row="1" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{Binding Book.Name}" FontWeight="Bold" FontSize="14" Foreground="#333"  FontFamily="Book Antiqua"/>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,5"  FontFamily="Book Antiqua"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Rating, StringFormat=Оценка: {0}/10}" FontSize="12" FontFamily="Book Antiqua"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat=' ({0:dd.MM.yyyy})'}" FontSize="12" Foreground="Gray"  FontFamily="Book Antiqua"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Page>
