<Page x:Class="UP.Pages.ReadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReadPage" Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="Назад" Width="80" Height="30" Click="BtnBack_Click" FontFamily="Book Antiqua"/>
            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" FontFamily="Book Antiqua" Margin="20,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,0,20,0">
            <TextBlock Text="{Binding Text}" FontSize="16" FontFamily="Georgia" TextWrapping="Wrap" LineHeight="24" Foreground="#2B2B2B" TextAlignment="Justify"/>
        </ScrollViewer>
    </Grid>
</Page>
