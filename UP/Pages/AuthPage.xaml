<Page x:Class="UP.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="BackButton" Click="BackButton_Click" Content="Назад" FontFamily="Book Antiqua" FontSize="16" Height="30" Margin="5" Width="150" HorizontalAlignment="Left"/>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Авторизация" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Book Antiqua"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Логин:" FontSize="20" Margin="15" FontFamily="Book Antiqua"/>
                <TextBox x:Name="LoginTB" Height="30" Width="180" Margin="12,0,0,0" FontSize="16" FontFamily="Book Antiqua"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock  Text="Пароль:" FontSize="20" Margin="15" FontFamily="Book Antiqua"/>
                <TextBox x:Name="PasswordTB" Height="30" Width="180" FontSize="16" FontFamily="Book Antiqua"/>
            </StackPanel>
            <Button x:Name="LogInButton" Content="Войти" Height="30" Width="200" FontFamily="Book Antiqua" FontSize="18" Margin="10" Click="LogInButton_Click"/>

            <Button Content="Если у вас нет аккаунта - зарегистрируйтесь" FontFamily="Book Antiqua" FontSize="16" Click="Button_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="White" BorderBrush="Transparent" BorderThickness="0" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Page>
