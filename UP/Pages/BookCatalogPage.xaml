<Page x:Class="UP.Pages.BookCatalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookCatalog" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBox x:Name="SearchTB" FontFamily="Book Antiqua" Width="150" Margin="5" TextChanged="SearchTB_TextChanged"/>

            <ComboBox x:Name="NameAndRatingCB" FontFamily="Book Antiqua" Width="150" Margin="5">
                <ComboBoxItem Content="В алфавитном порядке" FontFamily="Book Antiqua"/>
                <ComboBoxItem Content="Не в алфавитном порядке" FontFamily="Book Antiqua"/>
                <ComboBoxItem Content="Рейтинг ↑" FontFamily="Book Antiqua"/>
                <ComboBoxItem Content="Рейтинг ↓" FontFamily="Book Antiqua"/>
            </ComboBox>                
            <ComboBox x:Name="SortGenreCB" FontFamily="Book Antiqua" Width="150" Margin="5">
                <ComboBoxItem Content="Антиутопия" FontFamily="Book Antiqua"/>
                <ComboBoxItem Content="Классика" FontFamily="Book Antiqua"/>
                <ComboBoxItem Content="Роман" FontFamily="Book Antiqua"/>
                <ComboBoxItem Content="Романтика" FontFamily="Book Antiqua"/>
                <ComboBoxItem Content="Современная проза" FontFamily="Book Antiqua"/>
                <ComboBoxItem Content="Хоррор" FontFamily="Book Antiqua"/>
            </ComboBox>

            <Button Content="Применить" Width="90"  Margin="5" Click="ApplyFilter_Click" FontFamily="Book Antiqua"/>
            <Button Content="✕" Width="30" Margin="5" Click="ResetFilter_Click" FontFamily="Book Antiqua"/>
        </StackPanel>

        <ListBox Grid.Row="1" Grid.Column="1" x:Name="BookListBox" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="15" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" MouseDoubleClick="BookListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="220">
                        <Image Margin="5" Source="{Binding ImagePath}" Height="330"  Stretch="UniformToFill"/>
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="16" FontWeight="Bold" FontFamily="Book Antiqua"  Margin="5"/>
                        <TextBlock Text="{Binding User.Name, StringFormat=Автор: {0}}" FontSize="14" Margin="5" FontFamily="Book Antiqua"/>
                        <TextBlock Text="{Binding AverageRating, StringFormat=Рейтинг: {0}}" FontSize="14" Margin="5" FontFamily="Book Antiqua"/>
                        <TextBlock Text="{Binding GenresText}" FontSize="14" Margin="5" FontFamily="Book Antiqua" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
