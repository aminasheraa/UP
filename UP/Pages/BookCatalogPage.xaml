<Page x:Class="UP.Pages.BookCatalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookCatalog" Background="White">

    <Grid>
        <ListBox Grid.Row="1" Grid.Column="1" x:Name="BookListBox" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="15" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="220">
                        <Image Margin="5" Source="{Binding ImagePath}" Height="330"  Stretch="UniformToFill"/>
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="16" FontWeight="Bold" FontFamily="Book Antiqua"  Margin="5"/>
                        <TextBlock Text="{Binding User.Name, StringFormat=Автор: {0}}" FontSize="14" Margin="5" FontFamily="Book Antiqua"/>
                        <TextBlock Text="{Binding AverageRating, StringFormat=Рейтинг: {0}}" FontSize="14" Margin="5" FontFamily="Book Antiqua"/>
                        <TextBlock Text="{Binding GenresText}" FontSize="14" Margin="5" FontFamily="Book Antiqua" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
