<Page x:Class="UP.Pages.BookCatalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookCatalog" Background="White" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBox x:Name="SearchTB" FontFamily="Book Antiqua" Width="150" Margin="5" TextChanged="SearchTB_TextChanged"/>

            <ComboBox x:Name="NameAndRatingCB" FontFamily="Book Antiqua" Width="170" Margin="5" SelectedIndex="0" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="В алфавитном порядке"/>
                <ComboBoxItem Content="Не в алфавитном порядке"/>
                <ComboBoxItem Content="Рейтинг ↑"/>
                <ComboBoxItem Content="Рейтинг ↓"/>
            </ComboBox>

            <ComboBox x:Name="SortGenreCB" FontFamily="Book Antiqua" Width="150" Margin="5" SelectionChanged="FilterChanged" SelectedIndex="0">
                <ComboBoxItem Content="Все жанры"/>
                <ComboBoxItem Content="Антиутопия"/>
                <ComboBoxItem Content="Классика"/>
                <ComboBoxItem Content="Роман"/>
                <ComboBoxItem Content="Романтика"/>
                <ComboBoxItem Content="Современная проза"/>
                <ComboBoxItem Content="Хоррор"/>
            </ComboBox>

            <Button Content="✕" Width="30" Margin="5" Click="ResetFilter_Click" FontFamily="Book Antiqua"/>
        </StackPanel>

        <ListBox Grid.Row="1" Grid.Column="1" x:Name="BookListBox" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" MouseDoubleClick="BookListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>

                    <StackPanel Width="160" Background="Transparent">
                        <Image Margin="5" Source="{Binding ImagePath}" Height="240"  Stretch="UniformToFill"/>
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="14" FontWeight="Bold" FontFamily="Book Antiqua"  Margin="5"/>
                        <TextBlock Text="{Binding User.Name, StringFormat=Автор: {0}}" FontSize="12" Margin="5, 0" FontFamily="Book Antiqua"/>
                        <TextBlock Text="{Binding AverageRating, StringFormat=Рейтинг: {0}}" FontSize="12" Margin="5,0" FontFamily="Book Antiqua"/>
                        <TextBlock Text="{Binding GenresText}" FontSize="12" Margin="5" FontFamily="Book Antiqua" TextWrapping="Wrap"/>

                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="В планах" Click="MenuItem_Click" Tag="2"/>
                                <MenuItem Header="Читаю" Click="MenuItem_Click" Tag="3"/>
                                <MenuItem Header="Прочитано" Click="MenuItem_Click" Tag="4"/>
                                <MenuItem Header="Заброшено" Click="MenuItem_Click" Tag="1"/>
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                    </StackPanel>
                    
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
