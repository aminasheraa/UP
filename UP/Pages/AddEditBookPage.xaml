<Page x:Class="UP.Pages.AddEditBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:UP.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditBookPage" Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                <TextBlock x:Name="PageTitle" Text="Добавление книги" FontSize="28" FontWeight="Bold" FontFamily="Book Antiqua" Margin="0,0,0,25"/>

                <TextBlock Text="Название книги" Margin="0,0,0,5" FontFamily="Book Antiqua" FontWeight="SemiBold"/>
                <TextBox x:Name="NameTB" Height="30" FontFamily="Book Antiqua" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                <TextBlock Text="Краткое описание (аннотация)" Margin="0,0,0,5" FontFamily="Book Antiqua" FontWeight="SemiBold"/>
                <TextBox x:Name="DescriptionTB" Height="50" FontFamily="Book Antiqua" Margin="0,0,0,15" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="Жанры" Margin="0,0,0,5" FontFamily="Book Antiqua" FontWeight="SemiBold"/>
                <ListBox x:Name="GenresListBox" Height="120" FontFamily="Book Antiqua" Margin="0,0,0,15" SelectionMode="Multiple" DisplayMemberPath="Name"/>
                
                <TextBlock Text="Полный текст книги" Margin="0,0,0,5" FontFamily="Book Antiqua" FontWeight="SemiBold"/>
                <TextBox x:Name="BookTextTB"  Margin="0,0,0,15" FontFamily="Book Antiqua" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5"/>

                <TextBlock Text="Обложка книги" Margin="0,0,0,5" FontFamily="Book Antiqua" FontWeight="SemiBold"/>
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ImagePathTB" FontFamily="Book Antiqua" Height="30" VerticalContentAlignment="Center" Background="#F9F9F9"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Сохранить" Width="150" Height="40" FontWeight="Bold" Click="SaveBtn_Click" FontFamily="Book Antiqua"/>


                    <Button Content="Отмена" Width="100" Height="40" Margin="20,0,0,0" Click="CancelBtn_Click" Background="#E0E0E0" FontFamily="Book Antiqua"/>


                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
