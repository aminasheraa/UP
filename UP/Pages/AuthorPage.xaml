<Page x:Class="UP.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorPage" Background="White">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
            <TextBlock Text="Моё творчество" FontSize="26" FontWeight="Bold" FontFamily="Book Antiqua"/>
            <Button Content="Добавить новую книгу" FontFamily="Book Antiqua" Width="150" Margin="30,0,0,0" Click="AddBookBtn_Click"/>
        </StackPanel>

        <ListBox x:Name="AuthorBooksListBox" Grid.Row="1" Margin="0,20,0,0" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="160">
                        <Image Source="{Binding ImagePath}" Height="240" Stretch="UniformToFill"/>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,5" TextAlignment="Center" FontFamily="Book Antiqua" TextWrapping="Wrap"/>

                        <TextBlock x:Name="FrozenTxt" Text="ЗАМОРОЖЕНА" FontFamily="Book Antiqua" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Center" Loaded="FrozenElement_Loaded"/>
                        <Button x:Name="AppealBtn" Content="Оспорить заморозку" FontFamily="Book Antiqua"  Margin="0,5,0,0" Background="#FFF3F3" Loaded="FrozenElement_Loaded" Click="AppealBookBtn_Click"/>

                        <Button Content="Редактировать" Margin="0,10,0,0" Click="EditBookBtn_Click" FontFamily="Book Antiqua"/>

                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
