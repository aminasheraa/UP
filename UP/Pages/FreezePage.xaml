<Page x:Class="UP.Pages.FreezePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FreezePage" Background="White">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        


            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🔒" FontSize="60" TextAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Ваш аккаунт заморожен" FontSize="20" FontWeight="Bold"  TextAlignment="Center" FontFamily="Book Antiqua" Margin="0,0,0,15"/>
            <TextBlock Text="Доступ к функциям приложения временно ограничен администрацией из-за нарушения правил платформы." FontSize="16" TextWrapping="Wrap" TextAlignment="Center" FontFamily="Book Antiqua" Foreground="#555555" Margin="0,0,0,25" Width="671"/>

            <Separator Margin="0,0,0,20"/>
            <TextBlock Text="Что это значит?" FontWeight="Bold" Margin="0,0,0,5" FontFamily="Book Antiqua"/>
            <TextBlock Text="Вы не можете читать книги, добавляь их в списки оставлять отзывы и жалобы." Margin="5,0,0,0" FontFamily="Book Antiqua"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Оспорить заморозку" Width="200" Height="35" Margin="0,30,20,0" FontFamily="Book Antiqua" Click="BtnAppeal_Click"/>
                <Button Content="Выйти из аккаунта" Width="200" Height="35" Margin="0,30,0,0" FontFamily="Book Antiqua" Click="BtnLogout_Click"/>

            </StackPanel>
            </StackPanel>
    </Grid>
</Page>
