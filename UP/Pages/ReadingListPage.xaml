<Page x:Class="UP.Pages.ReadingListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReadingListPage" Background="White">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBox x:Name="SearchTB" FontFamily="Book Antiqua" Width="150" Margin="5" TextChanged="SearchTB_TextChanged"/>

            <ComboBox x:Name="NameAndRatingCB" FontFamily="Book Antiqua" Width="170" Margin="5" SelectedIndex="0" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="В алфавитном порядке"/>
                <ComboBoxItem Content="Не в алфавитном порядке"/>
                <ComboBoxItem Content="Рейтинг ↑"/>
                <ComboBoxItem Content="Рейтинг ↓"/>
            </ComboBox>

            <ComboBox x:Name="SortGenreCB" FontFamily="Book Antiqua" Width="150" Margin="5" SelectionChanged="FilterChanged" SelectedIndex="0">
                <ComboBoxItem Content="Все жанры"/>
                <ComboBoxItem Content="Антиутопия"/>
                <ComboBoxItem Content="Классика"/>
                <ComboBoxItem Content="Роман"/>
                <ComboBoxItem Content="Романтика"/>
                <ComboBoxItem Content="Современная проза"/>
                <ComboBoxItem Content="Хоррор"/>
            </ComboBox>

            <Button Content="✕" Width="30" Margin="5" Click="ResetFilter_Click" FontFamily="Book Antiqua"/>
        </StackPanel>
        
        <TabControl Grid.Row="1" x:Name="SectionTabControl" SelectionChanged="SectionChanged">
            <TabItem Header="В планах" Tag="2" FontFamily="Book Antiqua"/>
            <TabItem Header="Читаю" Tag="3" FontFamily="Book Antiqua"/>
            <TabItem Header="Прочитано" Tag="4" FontFamily="Book Antiqua"/>
            <TabItem Header="Заброшено" Tag="1" FontFamily="Book Antiqua"/>
        </TabControl>

        <ListBox Grid.Row="2" x:Name="ReadingListBox" MouseDoubleClick="ReadingListBox_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="150" Margin="10" Background="Transparent">
                        <Image Source="{Binding Book.ImagePath}" Height="240" Stretch="UniformToFill"/>
                        <TextBlock Text="{Binding Book.Name}" FontSize="14" FontWeight="Bold" TextAlignment="Center" FontFamily="Book Antiqua" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Book.User.Name}" FontSize="12" TextAlignment="Center" FontFamily="Book Antiqua"/>

                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="В планах" Click="MenuItem_Click" Tag="2"/>
                                <MenuItem Header="Читаю" Click="MenuItem_Click" Tag="3"/>
                                <MenuItem Header="Прочитано" Click="MenuItem_Click" Tag="4"/>
                                <MenuItem Header="Заброшено" Click="MenuItem_Click" Tag="1"/>
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
