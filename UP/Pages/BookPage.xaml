<Page x:Class="UP.Pages.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookPage" Background="White" Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <Image Height="280" Stretch="UniformToFill" Source="{Binding ImagePath}"/>
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" FontFamily="Book Antiqua" TextWrapping="Wrap" Margin="0,8,0,4"/>
                <TextBlock Text="{Binding User.Name, StringFormat=Автор: {0}}" FontSize="13" FontFamily="Book Antiqua" Margin="0,1"/>
                <TextBlock Text="{Binding GenresText}" FontSize="13" FontFamily="Book Antiqua" TextWrapping="Wrap" Margin="0,1"/>
                <TextBlock Text="{Binding AverageRating, StringFormat=Рейтинг: {0:F1}}" FontSize="13" FontFamily="Book Antiqua" FontWeight="Bold" Margin="0,1,0,10"/>
                <Button Content="Читать" FontFamily="Book Antiqua" Height="25" Margin="0,2" FontSize="12" Click="BtnRead_Click"/>
                <Button Content="В список" FontFamily="Book Antiqua" Height="25" Margin="0,2" FontSize="12">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="В планах" Click="MenuItem_Click" Tag="2"/>
                            <MenuItem Header="Читаю" Click="MenuItem_Click" Tag="3"/>
                            <MenuItem Header="Прочитано" Click="MenuItem_Click" Tag="4"/>
                            <MenuItem Header="Заброшено" Click="MenuItem_Click" Tag="1"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="Click">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="ContextMenu.IsOpen">
                                                <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True"/>
                                            </BooleanAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="Жалоба:" FontSize="12" FontFamily="Book Antiqua"/>
                <Button Content="На книгу" Height="22" FontFamily="Book Antiqua" Margin="0,10,0,2" FontSize="11" Click="BtnComplaint_Click" Tag="Книга"/>
                <Button Content="На автора" Height="22" FontFamily="Book Antiqua" Margin="0,2" FontSize="11" Click="BtnComplaint_Click" Tag="Автор"/>
                <StackPanel x:Name="AdminPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <Button Content="Заморозить" FontFamily="Book Antiqua" Height="25" Background="#FFCCCC" FontSize="11" Click="BtnFreezeBook_Click"/>
                </StackPanel>
                <Button Content="Назад" Height="25" FontFamily="Book Antiqua" Click="BtnBack_Click" Margin="0,15,0,0" FontSize="12"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Описание" FontSize="15" FontWeight="Bold" FontFamily="Book Antiqua" Margin="0,0,0,3"/>
                <TextBlock Text="{Binding Description}" FontSize="13" TextWrapping="Wrap" FontFamily="Book Antiqua" Margin="0,0,0,15"/>
                <Separator Margin="0,0,0,10"/>
                <TextBlock Text="Оставить отзыв" FontSize="14" FontWeight="Bold" FontFamily="Book Antiqua" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NewReviewText}" x:Name="NewReviewText" Height="45" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Оценка:" VerticalAlignment="Center" FontSize="12" FontFamily="Book Antiqua" Margin="0,0,5,0"/>
                    <ComboBox Width="45" Height="20" FontSize="11" SelectedItem="{Binding NewReviewRating}" x:Name="NewReviewRating" FontFamily="Book Antiqua">
                        <ComboBoxItem Content="10" /><ComboBoxItem Content="9"/><ComboBoxItem Content="8"/><ComboBoxItem Content="7"/><ComboBoxItem Content="6"/><ComboBoxItem Content="5"/><ComboBoxItem Content="4"/><ComboBoxItem Content="3"/><ComboBoxItem Content="2"/><ComboBoxItem Content="1"/>
                    </ComboBox>
                    <Button Content="Отправить" FontFamily="Book Antiqua" Width="80" Height="20" FontSize="11" Margin="10,0,0,0" Click="BtnSendReview_Click"/>
                </StackPanel>

                <TextBlock Text="Отзывы:" FontSize="15" FontWeight="Bold" FontFamily="Book Antiqua" Margin="0,0,0,8"/>
                <ListBox x:Name="ReviewListBox" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="{Binding User.Name}" FontSize="13" FontWeight="Bold" FontFamily="Book Antiqua"/>
                                    <TextBlock Text="{Binding Rating, StringFormat=Оценка: {0}}" FontSize="12" FontFamily="Book Antiqua"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat=Дата: {0:d}}" FontSize="11" Foreground="Gray" FontFamily="Book Antiqua"/>
                                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" FontFamily="Book Antiqua" Margin="0,4,0,6"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Жалоба" Click="BtnComplaintReview_Click" FontSize="10" Padding="5,0" Margin="0,0,10,0" FontFamily="Book Antiqua"/>
                                        <Button x:Name="FreezeBtn" Content="Заморозить" Click="BtnFreezeReview_Click" FontSize="10" Padding="5,0" Background="#FFCCCC" Loaded="FreezeBtn_Loaded" FontFamily="Book Antiqua"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
